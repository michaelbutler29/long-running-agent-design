# Copy to .env and fill in from infrastructure/cdk-outputs.json after deploy.
AGENTCORE_GATEWAY_URL=https://<gateway-id>.gateway.bedrock-agentcore.<region>.amazonaws.com/mcp
AGENTCORE_GATEWAY_ARN=arn:aws:bedrock-agentcore:<region>:<account-id>:gateway/<gateway-id>
AGENTCORE_POLICY_ENGINE_ID=<policy-engine-id>
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=global.anthropic.claude-sonnet-4-6
